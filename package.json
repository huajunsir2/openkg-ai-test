{
  "name": "openkg-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OpenKG 开放知识图谱新版官方网站 - 大模型时代的知识工程社区",
  "scripts": {
    "dev": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js && node scripts/deploy-root.mjs",
    "build:dist": "vite build --config web/vite.config.js",
    "preview": "vite preview --config web/vite.config.js --port 4173"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "sass": "^1.83.0",
    "vite": "^6.0.7"
  }
}
